<?xml version='1.0' encoding='utf-8'?>
<widget id="com.blockblast.game" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Block Blast</name>
    <description>
        An addictive puzzle game similar to Block Blast with Appodeal ad integration
    </description>
    <author email="dev@blockblast.com" href="https://blockblast.com">
        Block Blast Game Team
    </author>
    <content src="index.html" />
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <!-- Android specific settings -->
    <platform name="android">
        <allow-intent href="market:*" />
        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />
        
        <!-- Android preferences -->
        <preference name="android-minSdkVersion" value="21" />
        <preference name="android-targetSdkVersion" value="33" />
        
        <!-- Enable hardware acceleration -->
        <preference name="android-hardwareAccelerated" value="true" />
    </platform>
    
    <!-- iOS specific settings -->
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <icon height="57" src="res/icon/ios/icon.png" width="57" />
        <icon height="114" src="res/icon/ios/icon@2x.png" width="114" />
        <icon height="29" src="res/icon/ios/icon-small.png" width="29" />
        <icon height="58" src="res/icon/ios/icon-small@2x.png" width="58" />
        <icon height="87" src="res/icon/ios/icon-small@3x.png" width="87" />
        <icon height="120" src="res/icon/ios/icon-60@2x.png" width="120" />
        <icon height="180" src="res/icon/ios/icon-60@3x.png" width="180" />
        
        <!-- iOS preferences -->
        <preference name="target-device" value="universal" />
        <preference name="deployment-target" value="11.0" />
    </platform>
    
    <!-- General preferences -->
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#667eea" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackupWebStorage" value="local" />
    
    <!-- Plugins -->
    <!-- Core Cordova plugins -->
    <plugin name="cordova-plugin-whitelist" spec="~1.3.5" />
    <plugin name="cordova-plugin-device" spec="~2.1.0" />
    <plugin name="cordova-plugin-statusbar" spec="~2.4.3" />
    <plugin name="cordova-plugin-splashscreen" spec="~6.0.0" />
    
    <!-- Appodeal plugin for ads -->
    <!-- Note: You need to install Appodeal Cordova plugin -->
    <!-- For Android: cordova plugin add https://github.com/appodeal/appodeal-cordova-plugin.git -->
    <!-- For iOS: requires CocoaPods -->
    <plugin name="appodeal-cordova-plugin" spec="~2.11.0">
        <variable name="APP_ID_ANDROID" value="YOUR_ANDROID_APP_KEY" />
        <variable name="APP_ID_IOS" value="YOUR_IOS_APP_KEY" />
    </plugin>
    
    <!-- Additional useful plugins -->
    <plugin name="cordova-plugin-vibration" spec="~3.1.1" />
    <plugin name="cordova-plugin-network-information" spec="~3.0.0" />
    
    <!-- Splash screen configuration -->
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="3000" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="ShowSplashScreenSpinner" value="false" />
</widget>
